	measure 'Total Revenue Trend' =
			VAR SelYear = SELECTEDVALUE(Calendar[Year])
			VAR SelMonthNum = SELECTEDVALUE(Calendar[MonthNumber])
			VAR FallbackDate = CALCULATE(MAX(Calendar[Date]), ALL(Calendar))
			VAR SelectedDate = IF(NOT ISBLANK(SelYear) && NOT ISBLANK(SelMonthNum), DATE(SelYear, SelMonthNum, 1), DATE(YEAR(FallbackDate), MONTH(FallbackDate), 1))
			VAR Offset = SELECTEDVALUE(TrendMonths[Offset])
			VAR TargetDate = EDATE(SelectedDate, Offset)
			RETURN CALCULATE([Total Revenue], REMOVEFILTERS(Calendar), Calendar[Year] = YEAR(TargetDate), Calendar[MonthNumber] = MONTH(TargetDate))
		displayFolder: Trend
		lineageTag: 667e92e6-4a71-4d15-86da-3e87d937957e

	measure 'Total Orders Trend' =
			VAR SelYear = SELECTEDVALUE(Calendar[Year])
			VAR SelMonthNum = SELECTEDVALUE(Calendar[MonthNumber])

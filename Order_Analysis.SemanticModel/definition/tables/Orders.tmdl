	measure 'Top Payment Type' =
			VAR Summary = ADDCOLUMNS(VALUES(Orders[Payment_Type]), "cnt", CALCULATE(COUNTROWS(Orders)))
			VAR TopRow = TOPN(1, Summary, [cnt], DESC)
			RETURN MAXX(TopRow, Orders[Payment_Type])
		displayFolder: Base Measures
		lineageTag: afdbc609-c76f-4c3d-9fac-38b43ab5004d


	measure 'Day Color Format' =
			VAR CurrentNum = [Total Orders]
			VAR MaxNumber = CALCULATE(MAXX(VALUES(Orders[Order_DayName]), [Total Orders]), ALLSELECTED(Orders))
			VAR MinNumber = CALCULATE(MINX(VALUES(Orders[Order_DayName]), [Total Orders]), ALLSELECTED(Orders))
			RETURN SWITCH(TRUE(), CurrentNum = MaxNumber, "#1E8E3E", CurrentNum = MinNumber, "#D93025", "#E69F00")
		displayFolder: Heatmap
		lineageTag: f7a8b9c0-d1e2-43f4-0516-2b3c4d5e6f7a

	measure 'Hour Color Format' =
			VAR CurrentNum = [Total Orders]
			VAR MaxNumber = CALCULATE(MAXX(VALUES(Orders[Order_HourLabel]), [Total Orders]), ALLSELECTED(Orders))
			VAR MinNumber = CALCULATE(MINX(VALUES(Orders[Order_HourLabel]), [Total Orders]), ALLSELECTED(Orders))
			RETURN SWITCH(TRUE(), CurrentNum = MaxNumber, "#1E8E3E", CurrentNum = MinNumber, "#D93025", "#E69F00")
		displayFolder: Heatmap
		lineageTag: 08b9c0d1-e2f3-44a5-1627-3c4d5e6f7a8b

	measure 'Heatmap Grid Max' = CALCULATE(MAXX(VALUES(Orders[Order_HourLabel]), MAX(MAX(MAX(MAX(MAX(MAX([Orders Sun], [Orders Mon]), [Orders Tue]), [Orders Wed]), [Orders Thu]), [Orders Fri]), [Orders Sat])), ALLSELECTED(Orders))
		displayFolder: Heatmap
		lineageTag: 19c0d1e2-f3a4-45b6-2738-4d5e6f7a8b9c

	measure 'Orders Sun Font Format' = IF([Orders Sun] = [Heatmap Grid Max], "#FFFFFF", "#333333")

	partition Orders = m
		mode: import
		source =
				let
				    Source = Csv.Document(File.Contents("C:\GitHub\power-bi-order-analysis\press_on_nails_orders.csv"),[Delimiter=",", Columns=11, Encoding=65001, QuoteStyle=QuoteStyle.Csv]),
				    #"Promoted Headers" = Table.PromoteHeaders(Source, [PromoteAllScalars=true]),
				    #"Cleaned Revenue" = Table.TransformColumns(#"Promoted Headers", {{"Revenue", each Number.FromText(Text.Remove(_, {"C", "A", "$", ","}))}}),
				    #"Changed Type" = Table.TransformColumnTypes(#"Cleaned Revenue",{{"Order_ID", type text}, {"Order_Date", type date}, {"Order_Time", type time}, {"Fulfillment_Date", type date}, {"Fulfillment_Time", type time}, {"Fulfillment_Method", type text}, {"Customer_Name", type text}, {"Customer_Postal_Code", type text}, {"Units_Sold", Int64.Type}, {"Revenue", type number}, {"Payment_Type", type text}})
				in
				    #"Changed Type"

